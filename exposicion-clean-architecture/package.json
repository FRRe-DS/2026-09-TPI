    "test": "tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "express": "^5.3.0"
  }
}
